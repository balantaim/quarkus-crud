    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "\n"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\n// Only parse JSON if the response is successful\nif (pm.response.code === 200) {\n    // Parse the JSON response\n    const response = pm.response.json();\n    // Extract the tokens\n    const accessToken = response.access_token;\n    // Store it in an environment variable named 'ACCESS_TOKEN'\n    pm.environment.set(\"ACCESS_TOKEN\", accessToken);\n\n    const refreshToken = response.refresh_token;\n    // Store it in an environment variable named 'REFRESH_TOKEN'\n    pm.environment.set(\"REFRESH_TOKEN\", refreshToken);\n\n    const userId = pm.response.headers.get('User-Id');\n    pm.environment.set(\"USER_ID\", userId);\n}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{BASE_USER}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{BASE_PASSWORD}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/auth/login",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
